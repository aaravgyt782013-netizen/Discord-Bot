# Required
DISCORD_TOKEN=
MONGO_TOKEN=
DISCORD_ID=

# Webhook configuration used by LightCore's logging systems
WEBHOOK_ID=
WEBHOOK_TOKEN=

# Optional integrations
GIPHY_TOKEN=
OPENAI=
TOPGG_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
