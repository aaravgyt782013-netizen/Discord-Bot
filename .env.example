# Music / Lavalink (only required if you enable the relevant music setup)
LAVALINK_HOST=lava.link
LAVALINK_PASSWORD=
LAVALINK_PORT=80
LAVALINK_SECURE=false

# Optional bot presence
DISCORD_STATUS="Listening to LightCore"

