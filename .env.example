# Required
DISCORD_TOKEN=
MONGO_TOKEN=
DISCORD_ID=

# Default command prefix (guild-specific settings can override it)
DEFAULT_PREFIX=.

# Webhook configuration used by LightCore's logging systems
WEBHOOK_ID=
WEBHOOK_TOKEN=

# Optional integrations
GIPHY_TOKEN=
OPENAI=
TOPGG_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
RADIO=

# Music / Lavalink
LAVALINK_HOST=
LAVALINK_PASSWORD=
LAVALINK_PORT=2333
LAVALINK_SECURE=false

# Optional bot presence
DISCORD_STATUS="Listening to LightCore"

# Never commit a real token, password, API key or database credential to GitHub.
